{
  "name": "aria-drive",
  "version": "0.1.0",
  "type": "module",
  "description": "A meta-prompting, context engineering and spec-driven development system for Claude Code",
  "bin": {
    "aria-drive": "dist/bin/install.js"
  },
  "files": [
    "dist/",
    "commands/",
    "drive/",
    "agents/"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "ai",
    "meta-prompting",
    "context-engineering",
    "spec-driven-development"
  ],
  "author": "shaneholloman",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaneholloman/aria-drive.git"
  },
  "homepage": "https://github.com/shaneholloman/aria-drive",
  "bugs": {
    "url": "https://github.com/shaneholloman/aria-drive/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "bun build src/bin/install.ts --outdir dist/bin --target node && bun build src/hooks/drive-check-update.ts src/hooks/drive-statusline.ts --outdir dist/hooks --target node && node scripts/add-shebang.js",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.13",
    "@types/node": "^25.0.10",
    "typescript": "^5.9.3"
  }
}
